# Recall Backend Environment Variables

# 1. Gemini AI API Key (Required for agent summarization)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Cloud Database URL (Optional: defaults to SQLite bookmarks.db if unset)
# Example Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# Example Neon: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb
DATABASE_URL=

# 3. NextAuth JWT Shared Secret (Matches frontend NEXTAUTH_SECRET)
AUTH_SECRET=your_super_secret_jwt_key_here
